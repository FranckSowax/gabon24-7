# ============================================
# GABON INSIGHT - FRONTEND ENV
# ============================================
# Copier en .env.local et remplir
# En prod (Netlify) : configurer dans Netlify Dashboard > Site settings > Env vars

# Supabase (publiques, exposées au navigateur)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# URLs
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=https://gaboninsight.com

# Cloudflare Turnstile (CAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# E-Billing (paiement)
NEXT_PUBLIC_EBILLING_PORTAL_URL=https://staging.billing-easy.net

# Analytics (optionnel — composant désactivé si vide)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry (optionnel — à activer après install @sentry/nextjs)
# NEXT_PUBLIC_SENTRY_DSN=
