## 🔧 MODIFICATION server.js

```javascript
// En haut
const redisService = require('./config/redis');
const articleCache = require('./services/redis/article-cache');
const analytics = require('./services/redis/analytics');

// Fonction démarrage
async function startServer() {
  await redisService.connect();
  await articleCache.init();
  await analytics.init();
  
  app.listen(3001, () => console.log('✅ Server: http://localhost:3001'));
  
  cron.schedule('*/5 * * * *', async () => {
    await analytics.syncViewsToDatabase(supabaseService.supabase);
  });
  
  process.on('SIGINT', async () => {
    await redisService.disconnect();
    process.exit(0);
  });
}
startServer();
```

