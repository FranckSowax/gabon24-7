## 📄 FICHIERS À CRÉER

### 1. /backend/config/redis.js
```javascript
const Redis = require('ioredis');
class RedisService {
  constructor() { this.client = null; this.isConnected = false; }
  async connect() {
    const config = {
      host: process.env.REDIS_HOST,
      port: parseInt(process.env.REDIS_PORT),
      password: process.env.REDIS_PASSWORD,
      tls: process.env.REDIS_TLS === 'true' ? {} : undefined,
      retryStrategy: (times) => times > 3 ? null : Math.min(times * 100, 2000)
    };
    this.client = new Redis(config);
    this.client.on('ready', () => this.isConnected = true);
    await this.client.ping();
    console.log('✅ Redis connecté');
    return this.client;
  }
  getClient() { return this.client; }
  async healthCheck() { try { await this.client.ping(); return true; } catch { return false; } }
  async disconnect() { if (this.client) await this.client.quit(); }
}
module.exports = new RedisService();
```

### 2. /backend/services/redis/article-cache.js
```javascript
const redisService = require('../../config/redis');
class ArticleCacheService {
  constructor() {
    this.redis = null;
    this.TTL = { HOT: 300, TRENDING: 900, DETAIL: 3600, FEED: 300 };
    this.KEYS = { ARTICLE: 'gn:article:', TRENDING: 'gn:trending:', FEED: 'gn:feed:' };
  }
  async init() { this.redis = redisService.getClient(); }
  async getArticle(id) {
    const cached = await this.redis.get(`${this.KEYS.ARTICLE}${id}`);
    return cached ? JSON.parse(cached) : null;
  }
  async setArticle(id, data, ttl = null) {
    await this.redis.setex(`${this.KEYS.ARTICLE}${id}`, ttl || this.TTL.DETAIL, JSON.stringify(data));
  }
  async getTrendingArticles(limit = 10) {
    const results = await this.redis.zrevrange(`${this.KEYS.TRENDING}24h`, 0, limit - 1, 'WITHSCORES');
    const trending = [];
    for (let i = 0; i < results.length; i += 2) {
      trending.push({ articleId: results[i], viewCount: parseInt(results[i + 1]) });
    }
    return trending;
  }
  async incrementTrending(id, inc = 1) {
    return await this.redis.zincrby(`${this.KEYS.TRENDING}24h`, inc, id);
  }
  async getFeed(type, params = {}) {
    const key = `${this.KEYS.FEED}${type}:p${params.page || 1}`;
    const cached = await this.redis.get(key);
    return cached ? JSON.parse(cached) : null;
  }
  async setFeed(type, data, params = {}) {
    const key = `${this.KEYS.FEED}${type}:p${params.page || 1}`;
    await this.redis.setex(key, this.TTL.FEED, JSON.stringify(data));
  }
}
module.exports = new ArticleCacheService();
```

### 3. /backend/services/redis/analytics.js
```javascript
const redisService = require('../../config/redis');
class AnalyticsService {
  constructor() {
    this.redis = null;
    this.KEYS = { VIEWS: 'gn:views:', SHARES: 'gn:shares:', TRENDING: 'gn:trending:rt' };
  }
  async init() { this.redis = redisService.getClient(); }
  async incrementViews(articleId) {
    const count = await this.redis.incr(`${this.KEYS.VIEWS}${articleId}`);
    await this.redis.zincrby(this.KEYS.TRENDING, 1, articleId);
    return count;
  }
  async getViews(articleId) {
    const views = await this.redis.get(`${this.KEYS.VIEWS}${articleId}`);
    return views ? parseInt(views) : 0;
  }
  async getBatchViews(articleIds) {
    const pipeline = this.redis.pipeline();
    articleIds.forEach(id => pipeline.get(`${this.KEYS.VIEWS}${id}`));
    const results = await pipeline.exec();
    return results.map((r, i) => ({ articleId: articleIds[i], views: r[1] ? parseInt(r[1]) : 0 }));
  }
  async syncViewsToDatabase(supabase) {
    const keys = []; let cursor = '0';
    do {
      const result = await this.redis.scan(cursor, 'MATCH', `${this.KEYS.VIEWS}*`, 'COUNT', 100);
      cursor = result[0]; keys.push(...result[1]);
    } while (cursor !== '0');
    const pipeline = this.redis.pipeline();
    keys.forEach(k => pipeline.get(k));
    const results = await pipeline.exec();
    for (let i = 0; i < keys.length; i++) {
      const id = keys[i].replace(this.KEYS.VIEWS, '');
      const views = parseInt(results[i][1]) || 0;
      if (views > 0) await supabase.from('articles').update({ view_count: views }).eq('id', id);
    }
  }
}
module.exports = new AnalyticsService();
```

