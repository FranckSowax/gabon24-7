# ============================================
# 🔐 CONFIGURATION GABON24-7 BACKEND
# ============================================
# Copiez ce fichier en .env et remplissez les valeurs

# ============================================
# 🔑 CLÉS API OBLIGATOIRES
# ============================================

# Google Gemini 3 (Pour toute l'intelligence IA : Texte, Images, Analyse)
# Obtenir sur: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyDxR_fCMOx-vl8HP3YixQtkVbk-lJOYNx0

# RapidAPI (pour Football, TikTok, Météo)
# Obtenir sur: https://rapidapi.com/
RAPIDAPI_KEY=c681296a52mshc2c73586baf893bp135671jsn76eb375db9e7

# Whapi (pour notifications WhatsApp)
# Obtenir sur: https://whapi.cloud/
WHAPI_TOKEN=VOTRE_TOKEN_WHAPI_ICI
WHAPI_CHANNEL_ID=VOTRE_CHANNEL_ID_WHAPI_ICI

# Replicate (UNIQUEMENT pour la synthèse vocale TTS - Optionnel si audio désactivé)
REPLICATE_API_TOKEN=r8_VOTRE_TOKEN_ICI

# ============================================
# 📊 SUPABASE (OBLIGATOIRE)
# ============================================
SUPABASE_URL=https://ykytsadwfqoyusleoflf.supabase.co
SUPABASE_ANON_KEY=votre_anon_key
# ⚠️ IMPORTANT: Utiliser la clé SERVICE_ROLE pour le backend (bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key

# ============================================
# 📧 EMAIL / SENDGRID (Pour notifications)
# ============================================
# SendGrid API Key pour l'envoi d'emails
# Obtenir sur: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.votre_api_key_sendgrid

# Email expéditeur (doit être vérifié dans SendGrid)
# Vérifier sur: https://app.sendgrid.com/settings/sender_auth
SENDGRID_FROM_EMAIL=noreply@gabon-insight.com

# Emails administrateurs (séparés par des virgules)
ADMIN_EMAILS=admin@gabon-insight.com,sowaxcom@gmail.com

# ============================================
# 🌐 URLs
# ============================================
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ============================================
# 💳 PAIEMENTS PVIT (Mobile Money Gabon)
# ============================================
# Obtenir sur: https://dashboard.mypvit.pro
# Documentation: https://api.mypvit.pro
#
# CONFIGURATION DANS LE DASHBOARD PVIT:
# 1. Callback URL: https://votre-api-railway.up.railway.app/api/payments/pvit/callback
# 2. Reception URL: https://votre-api-railway.up.railway.app/api/payments/pvit/reception-secret
# 3. Success Redirect: https://gabon24-7.com/paiement/succes
# 4. Failed Redirect: https://gabon24-7.com/paiement/echec

# Code compte opération PVIT (format: ACC_XXXXXX)
PVIT_OPERATION_ACCOUNT_CODE=ACC_VOTRE_CODE

# Mot de passe pour renouvellement des clés
PVIT_RENEW_PASSWORD=votre_mot_de_passe_pvit

# Codes URLs configurés dans le dashboard PVIT (les codes retournés après création)
PVIT_CALLBACK_URL_CODE=XXXXX
PVIT_RECEPTION_URL_CODE=XXXXX
PVIT_SUCCESS_REDIRECTION_CODE=XXXXX
PVIT_FAILED_REDIRECTION_CODE=XXXXX

# URL de base PVIT (ne pas modifier)
PVIT_BASE_URL=https://api.mypvit.pro

# ============================================
# 💳 STRIPE (Paiement par carte - optionnel)
# ============================================
STRIPE_SECRET_KEY=sk_test_votre_cle_stripe

# ============================================
# �🔑 CLÉS OPTIONNELLES
# ============================================

# OpenAI (fallback si Replicate indisponible)
OPENAI_API_KEY=sk-proj-VOTRE_CLE_ICI

# SendGrid (newsletter) - déjà défini plus haut, cette ligne est un duplicata
# SENDGRID_API_KEY=SG.votre_api_key_sendgrid

# JWT (authentification)
# Utilisé par le middleware auth.js pour valider les tokens
# Pour Supabase, utiliser le JWT secret de votre projet Supabase
JWT_SECRET=un_secret_fort_de_32_caracteres_minimum
SUPABASE_JWT_SECRET=votre_jwt_secret_supabase

# ============================================
# 📝 NOTES RAILWAY
# ============================================
# En production Railway, configurez ces variables dans:
# Railway Dashboard > Variables > Add Variable
#
# Variables OBLIGATOIRES pour Railway:
# - GEMINI_API_KEY
# - RAPIDAPI_KEY
# - SUPABASE_URL
# - SUPABASE_SERVICE_ROLE_KEY
# - NODE_ENV=production
#
# Variables PVIT (pour les paiements Mobile Money):
# - PVIT_OPERATION_ACCOUNT_CODE
# - PVIT_RENEW_PASSWORD
# - PVIT_CALLBACK_URL_CODE
# - PVIT_RECEPTION_URL_CODE
# - PVIT_SUCCESS_REDIRECTION_CODE
# - PVIT_FAILED_REDIRECTION_CODE
# - PVIT_BASE_URL=https://api.mypvit.pro
#
# Variables optionnelles:
# - REPLICATE_API_TOKEN (pour TTS)
# - WHAPI_TOKEN (pour WhatsApp)
# - SENDGRID_API_KEY (pour emails)
# - REDIS_URL (pour cache)

# ============================================
# 🔴 REDIS CACHE (Optionnel mais recommandé)
# ============================================
# Redis accélère les réponses API via mise en cache
# Le serveur fonctionne sans Redis (dégradation gracieuse)
#
# Option 1: URL complète (Upstash, Railway, etc.)
REDIS_URL=redis://default:password@host:port
#
# Option 2: Variables séparées (alternative)
# REDIS_HOST=xxxxx.upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=votre_password
# REDIS_TLS=true
#
# Recommandations:
# - Upstash (gratuit jusqu'à 10k requêtes/jour): https://upstash.com
# - Railway Redis addon: https://railway.app
