# ============================================
# CONFIGURATION GABON24-7 BACKEND
# ============================================
# Copiez ce fichier en .env et remplissez les valeurs

# ============================================
# CLES API OBLIGATOIRES
# ============================================

# Google Gemini (Pour toute l'intelligence IA : Texte, Images, Analyse)
# Obtenir sur: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# RapidAPI (pour Football, TikTok, Météo)
# Obtenir sur: https://rapidapi.com/
RAPIDAPI_KEY=your_rapidapi_key_here

# Whapi (pour notifications WhatsApp)
# Obtenir sur: https://whapi.cloud/
WHAPI_TOKEN=your_whapi_token_here
# ID chaîne Gabon Insight (format: XXXX@newsletter)
WHAPI_CHANNEL_ID=120363423900961994@newsletter

# Replicate (UNIQUEMENT pour la synthèse vocale TTS - Optionnel si audio désactivé)
REPLICATE_API_TOKEN=your_replicate_token_here

# ============================================
# SUPABASE (OBLIGATOIRE)
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
# IMPORTANT: Utiliser la clé SERVICE_ROLE pour le backend (bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================
# EMAIL / SENDGRID (Pour notifications)
# ============================================
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@gabon-insight.com
ADMIN_EMAILS=admin@gabon-insight.com

# ============================================
# URLs
# ============================================
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ============================================
# E-BILLING (Gabon Insight - Paiements Mobile Money & Carte)
# ============================================
# Documentation: https://billing-easy.com
# Staging:
#   EBILLING_API_URL=https://stg.billing-easy.com/api/v1/merchant/e_bills
#   EBILLING_PORTAL_URL=https://staging.billing-easy.net
# Production:
#   EBILLING_API_URL=https://app.billing-easy.com/api/v1/merchant/e_bills
#   EBILLING_PORTAL_URL=https://app.billing-easy.net
EBILLING_API_URL=https://stg.billing-easy.com/api/v1/merchant/e_bills
EBILLING_PORTAL_URL=https://staging.billing-easy.net
EBILLING_USERNAME=your_ebilling_username
EBILLING_API_KEY=your_ebilling_api_key

# ============================================
# STRIPE (Paiement par carte - optionnel)
# ============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_key

# ============================================
# CLES OPTIONNELLES
# ============================================

# Kimi K2.5 (Moonshot AI - Génération d'opportunités WhatsApp)
# Documentation: https://platform.moonshot.ai/docs/guide/kimi-k2-5-quickstart
KIMI_API_KEY=your_kimi_api_key_here

# OpenAI (fallback si Replicate indisponible)
OPENAI_API_KEY=sk-proj-your_openai_key

# JWT (authentification)
JWT_SECRET=your_strong_secret_32_chars_minimum
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ============================================
# REDIS CACHE (Optionnel mais recommandé)
# ============================================
REDIS_URL=redis://default:password@host:port

# ============================================
# SECURITE / CRON
# ============================================
# Token partagé pour authentifier les appels Cron Netlify → Backend
CRON_SECRET=generate_a_random_strong_secret_here

# Cloudflare Turnstile (validation CAPTCHA backend)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ============================================
# API IA OPTIONNELLES
# ============================================
# Perplexity (recherche IA)
PPLX_API_KEY=pplx-your_key

# Quotas OpenAI (sécurité budget)
OPENAI_DAILY_LIMIT=1000
OPENAI_HOURLY_LIMIT=100
OPENAI_MONTHLY_BUDGET=200

# ============================================
# SPORTS / FOOTBALL
# ============================================
RAPIDAPI_FOOTBALL_KEY=your_rapidapi_football_key

# ============================================
# NOTIFICATIONS / ALERTES
# ============================================
ALERT_EMAIL_TO=admin@gabon-insight.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# SMTP alternatif si pas SendGrid
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# ============================================
# DEPLOIEMENT
# ============================================
PORT=3001
RAILWAY_PUBLIC_URL=https://your-app.up.railway.app
PHP_PAYMENT_BACKEND_URL=https://your-php-backend.example.com

# Sentry (optionnel — à activer après install @sentry/node)
# SENTRY_DSN=

# ============================================
# NOTES RAILWAY
# ============================================
# En production Railway, configurez ces variables dans:
# Railway Dashboard > Variables > Add Variable
#
# Variables OBLIGATOIRES pour Railway:
# - GEMINI_API_KEY
# - RAPIDAPI_KEY
# - SUPABASE_URL
# - SUPABASE_SERVICE_ROLE_KEY
# - EBILLING_API_URL
# - EBILLING_USERNAME
# - EBILLING_API_KEY
# - NODE_ENV=production
#
# Variables optionnelles:
# - KIMI_API_KEY (pour opportunités WhatsApp - Kimi K2.5)
# - REPLICATE_API_TOKEN (pour TTS)
# - WHAPI_TOKEN (pour WhatsApp)
# - SENDGRID_API_KEY (pour emails)
# - REDIS_URL (pour cache)
