# ============================================

# Google Gemini 3 (Pour toute l'intelligence IA : Texte, Images, Analyse)
# Obtenir sur: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyDxR_fCMOx-vl8HP3YixQtkVbk-lJOYNx0

# RapidAPI (pour Football, TikTok, Météo)
# Obtenir sur: https://rapidapi.com/
RAPIDAPI_KEY=c681296a52mshc2c73586baf893bp135671jsn76eb375db9e7

# Whapi (pour notifications WhatsApp)
# Obtenir sur: https://whapi.cloud/
WHAPI_TOKEN=VOTRE_TOKEN_WHAPI_ICI
